LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# Parlot — see packages/instrumentation-livekit/README.md
PARLOT_ENDPOINT=https://ingest.parlot.ai
# Mint in Parlot Settings → API Keys (shown once on create)
PARLOT_API_KEY=your_parlot_api_key
# Recording: Settings → Recording in Parlot (bootstrap policy)
