LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional — warm transfer / human escalation (voice + SIP trunk)
# LIVEKIT_SIP_OUTBOUND_TRUNK=ST_xxx
# LIVEKIT_SUPERVISOR_PHONE_NUMBER=+12003004000
# LIVEKIT_SIP_NUMBER=+15005006000

# Parlot — see packages/instrumentation-livekit/README.md
# Local platform stack: http://127.0.0.1:4318
PARLOT_ENDPOINT=https://ingest.parlot.ai
# Mint in Parlot Settings → API Keys (shown once on create)
PARLOT_API_KEY=your_parlot_api_key
# PARLOT_CAPTURE_CONTENT=false
