# Shared repo-level GitHub Actions secrets/vars (Phase 1).
#
# First-time SSH/host setup: ./scripts/create-staging-vm.sh pushes DEPLOY_* to
# GitHub automatically (DEPLOY_HOST, DEPLOY_USER, DEPLOY_KNOWN_HOSTS, DEPLOY_SSH_KEY).
#
# Use this file to rotate / repair shared values without recreating the VM, and
# to push website Wrangler credentials (required for Deploy website):
#   cp .env.deploy.shared.example .env.deploy.shared
#   # fill blanks below
#   ./scripts/push-github-env.sh --shared --file .env.deploy.shared
#   # Private key is multiline — set separately if rotating:
#   gh secret set DEPLOY_SSH_KEY < ~/.ssh/parlot-deploy
# Never commit real values.
#
# DEPLOY_HOST / DEPLOY_USER → repo Actions variables
# Everything else below → repo Actions secrets

# =============================================================================
# Deploy SSH / host (Phase 1 shared GCE VM)
# =============================================================================

DEPLOY_HOST=
DEPLOY_USER=parlot
DEPLOY_KNOWN_HOSTS=

# =============================================================================
# Website Worker — Deploy website (Wrangler)
# =============================================================================
# Required for packages/website → Cloudflare Workers (parlot.ai / www).
# Without these, Deploy website fails and Access-gated hosts hang (no origin).
#
# Create under Cloudflare → My Profile → API Tokens → Create Token → Custom:
#   Account resources: include your account
#   Zone resources: include zone parlot.ai (needed for custom-domain routes)
#   Permissions:
#     Account → Workers Scripts → Edit
#     Account → Account Settings → Read
#     Zone → Workers Routes → Edit
#     Zone → Zone → Read
# Account ID: Dashboard sidebar → copy Account ID (same as R2_ACCOUNT_ID numerically,
# but this secret is Wrangler-only and never lands on the VM).
# This is NOT the R2 S3 API token. Local Access/tunnel scripts need extra
# permissions — use a broader local token or export separately; see
# internal-docs → Secrets and env.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
