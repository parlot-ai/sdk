# Repo-level GitHub Actions secret for public docs publish.
#
# On push to main under docs/**, .github/workflows/docs.yml dispatches
# sdk-docs-updated to parlot-ai/platform (Deploy website embeds /docs/).
#
#   gh secret set PLATFORM_DISPATCH_TOKEN
#
# Value: fine-grained PAT on parlot-ai/platform with Contents: Read and write
# (required for repository_dispatch). Never commit real values.

PLATFORM_DISPATCH_TOKEN=
