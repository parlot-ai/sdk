# Repo-level GitHub Actions secret for public docs publish.
#
# On push to main under docs/**, .github/workflows/docs.yml dispatches
# sdk-docs-updated to parlot-ai/platform (Deploy website embeds /docs/).
#
#   gh secret set PARLOT_CROSS_REPO_TOKEN
#
# Value: fine-grained PAT with Contents: Read and write on parlot-ai/platform
# (required for repository_dispatch) and Contents: Read on parlot-ai/sdk.
# Same secret name/value is also set on platform and parlot-infra.
# Never commit real values.

PARLOT_CROSS_REPO_TOKEN=
