{
  "name": "@parlot/sdk-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bash scripts/sync-changelog.sh && bash scripts/build-pdoc.sh && bash scripts/build-typedoc.sh",
    "predev": "bash scripts/sync-changelog.sh",
    "build:pdoc": "bash scripts/build-pdoc.sh",
    "build:ts": "bash scripts/build-typedoc.sh",
    "build": "react-router build && cp -R build/client/docs/. build/ 2>/dev/null || true && cp -R build/client/. build/ 2>/dev/null || true",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "sync-changelog": "bash scripts/sync-changelog.sh",
    "check:leak": "bash scripts/check-public-leak.sh"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@react-router/node": "^7.8.0",
    "fumadocs-core": "^16.15.7",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.7",
    "isbot": "^5.2.2",
    "lucide-react": "^1.41.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.8.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.8.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "packageManager": "bun@1.3.13"
}
